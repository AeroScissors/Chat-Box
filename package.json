{
  "name": "ai-chat-widget",
  "version": "0.1.0",
  "description": "Framework-agnostic embeddable AI chat widget (Web Component + Shadow DOM) with Ollama, OpenAI-compatible and custom API providers.",
  "type": "module",
  "main": "dist/chat-widget.js",
  "types": "dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests server --ext .ts,.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"demo/**/*.html\" \"server/**/*.mjs\" \"*.md\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "proxy": "node server/proxy.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
